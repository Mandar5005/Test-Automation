<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configuration SYSTEM "log4j2.dtd">
<Configuration status="warn">
	<Properties>
		<Property name="basePath">./logs/</Property>
	</Properties>
	<Appenders>
	<Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{YYYY-MM-dd HH:mm:ss} %c{1}:%L - %msg%n" />
        </Console>
		<RollingFile name="fileLogger"
			fileName="${basePath}/logging.log"
			filePattern="${basePath}/app-%d{yyyy-MM-dd}.log">
			<PatternLayout>
				<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %c{1}:%L - %msg%n
				</pattern>
			</PatternLayout>
			<Policies>
				<TimeBasedTriggeringPolicy interval="1" modulate="true" />
				<SizeBasedTriggeringPolicy size="10MB" />
			</Policies>
			<!-- Max 10 files will be created everyday -->
			<DefaultRolloverStrategy max="10">
				<Delete basePath="${basePathr}" maxDepth="10">
					<!-- Delete all files older than 30 days -->
					<IfLastModified age="30d" />
				</Delete>
			</DefaultRolloverStrategy>
		</RollingFile>
	</Appenders>
	<Loggers>
        <Root level="info" additivity="false">
            <AppenderRef ref="Console" />
            <appender-ref ref="fileLogger" />
        </Root>
        <!-- Add this logger to stop logging from Apache POI -->
        <Logger name="org.apache.poi" level="OFF"/>
    </Loggers>
</Configuration>